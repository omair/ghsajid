---
import { getCollection, getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import { urduNumber } from "../lib/urdu";

const [ghazals, nazms, reviews, videos, books, darsGah] = await Promise.all([
  getCollection("ghazals"),
  getCollection("nazms"),
  getCollection("reviews"),
  getCollection("videos"),
  getCollection("books"),
  getEntry("containers", "dars-gah"),
]);

// The featured ghazal is the archive's opening one, whose سبز radeef gives the
// site its colour. Its matla is the site's signature couplet: it stands beside
// the portrait as identity, and again below as the piece offered to read.
const opening = await getEntry(
  "ghazals",
  "kisi-nigah-ki-zad-par-hai-baghi-sabz-mira",
);
const matla = ((opening?.body ?? "").split("\n\n")[0] ?? "").trim();
// Render both misras: first plain, second muted, the way a matla is set.
const matlaHtml = matla.replace(/\n/, '<br><span class="l2">') + "</span>";

const works = [
  {
    href: "/dars-gah/",
    title: darsGah?.data.title ?? "درس گاہ",
    count: darsGah?.data.contents.length ?? 0,
    note: "خودنوشت",
  },
  // کتابیں is a different axis from غزلیں/نظمیں: those list by form, this
  // lists by the book he published them in. It sits next to درس گاہ because
  // both are ways into whole works rather than into a single piece.
  { href: "/kitab/", title: "کتابیں", count: books.length, note: "مجموعے" },
  { href: "/ghazal/", title: "غزلیں", count: ghazals.length, note: "کلام" },
  { href: "/nazm/", title: "نظمیں", count: nazms.length, note: "کلام" },
  { href: "/tabsira/", title: "تبصرے", count: reviews.length, note: "تنقید" },
  { href: "/video/", title: "آواز", count: videos.length, note: "اپنی زبانی" },
];
---

<Base
  title="غلام حسین ساجد"
  description="اردو اور پنجابی شاعر و نقّاد غلام حسین ساجد کا کلام، تنقید اور خودنوشت"
  measure="wide"
>
  <section class="home-hero">
    <figure class="portrait">
      <img
        src="/media/images/71053136_2535873549784890_2302056858103316480_o.jpg"
        alt="غلام حسین ساجد"
        width="1491"
        height="2015"
      />
    </figure>
    <div>
      <h1 class="home-name">غلام حسین ساجد</h1>
      <p class="home-role">شاعر ، نقّاد ، استاد</p>
      <p class="home-place">بستی کبیر سنپال ۔ لاہور</p>
      <hr class="home-hairline" />
      <p class="home-matla"><Fragment set:html={matlaHtml} /></p>
    </div>
  </section>

  <hr class="seam" />

  <div class="editorial">
    <article class="feature">
      <span class="eyebrow feature__eyebrow">منتخب غزل</span>
      <p class="feature__matla"><Fragment set:html={matlaHtml} /></p>
      <a class="readmore" href={`/ghazal/${opening?.data.slug}`}>پوری غزل پڑھیے ←</a>
    </article>

    <aside class="fahrist">
      <span class="eyebrow fahrist__eyebrow">فہرست</span>
      {
        works.map((work) => (
          <a class="fahrist__item" href={work.href}>
            <span class="fahrist__left">
              <span class="fahrist__title">{work.title}</span>
              {work.note && <span class="fahrist__note">{work.note}</span>}
            </span>
            <span class="fahrist__count">{urduNumber(work.count)}</span>
          </a>
        ))
      }
      <figure class="fahrist__photo">
        <img
          src="/media/images/116016151_3213981008640804_6218243660421552257_n.jpg"
          alt=""
        />
        <figcaption>درس گاہ کے حصوں میں پرانی تصویریں</figcaption>
      </figure>
    </aside>
  </div>
</Base>
