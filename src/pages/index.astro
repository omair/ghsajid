---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const sections = [
  { title: "غزلیں", segment: "ghazal", entries: await getCollection("ghazals") },
  { title: "نظمیں", segment: "nazm", entries: await getCollection("nazms") },
  { title: "تبصرے", segment: "tabsira", entries: await getCollection("reviews") },
  { title: "ویڈیو", segment: "video", entries: await getCollection("videos") },
];
---

<Base title="غلام حسین ساجد">
  <h1>غلام حسین ساجد</h1>
  <p><a href="/dars-gah/">درس گاہ — خودنوشت، ۵۳ حصے</a></p>

  {
    sections.map((section) => (
      <section>
        <h2>{section.title}</h2>
        <ul>
          {section.entries.map((entry) => (
            <li>
              <a href={`/${section.segment}/${entry.data.slug}`}>
                {entry.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
