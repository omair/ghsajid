---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { urduNumber } from "../../lib/urdu";

const IMAGE = /!\[[^\]]*\]\(([^)]+)\)/;

// Turn a part's prose into a short incipit — the words it opens on — so the
// index reads like a table of contents with incipits rather than a bank of
// numbers. The 53 parts have no titles; the opening phrase stands in.
function incipit(body: string): string {
  const first = body
    .replace(new RegExp(IMAGE, "g"), "")
    .split("\n")
    .map((line) => line.trim())
    .find(Boolean);
  if (!first) return "";
  const words = first.split(/\s+/);
  return words.length > 13 ? words.slice(0, 13).join(" ") + " …" : first;
}

const parts = (await getCollection("memoir"))
  .sort((a, b) => a.data.part - b.data.part)
  .map((entry) => ({
    part: entry.data.part,
    incipit: incipit(entry.body ?? ""),
    thumb: (entry.body ?? "").match(IMAGE)?.[1] ?? null,
  }));
---

<Base title="درس گاہ" measure="wide">
  <h1 class="piece__title">درس گاہ</h1>
  <p class="piece__label">{urduNumber(parts.length)} حصے ۔ ایک خودنوشت</p>
  <p class="piece-note" style="margin:0 0 2.75rem">
    بستی کبیر سنپال کے کچّے راستوں اور جراحی کے پرائمری سکول سے شروع ہو کر لاہور
    کے ادبی حلقوں تک۔
  </p>

  <div class="memoir">
    {
      parts.map((p) => (
        <a class="memoir__part" href={`/dars-gah/${p.part}`}>
          <span class="memoir__n">{urduNumber(p.part)}</span>
          <p class="memoir__incipit">{p.incipit}</p>
          {p.thumb && <img class="memoir__thumb" src={p.thumb} alt="" loading="lazy" />}
        </a>
      ))
    }
  </div>
</Base>
