---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const entries = (await getCollection("nazms")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, "ur"),
);
---

<Base title="نظمیں">
  <h1 class="piece__title">نظمیں</h1>
  <p class="piece__label">اردو اور پنجابی</p>
  <ul class="listing">
    {
      entries.map((entry) => (
        <li>
          <a href={`/nazm/${entry.data.slug}`}>
            {entry.data.title}
            
          </a>
        </li>
      ))
    }
  </ul>
</Base>
