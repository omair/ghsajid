---
import { getCollection, render } from "astro:content";
import Piece from "../../layouts/Piece.astro";

export async function getStaticPaths() {
  const entries = await getCollection("reviews");
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { reviewed_book, reviewed_author } = entry.data;
const label = reviewed_author
  ? `تبصرہ ۔ ${reviewed_book ? `${reviewed_book} ۔ ` : ""}${reviewed_author}`
  : "تبصرہ";
---

<Piece
  title={entry.data.title}
  label={label}
  publishedIn={entry.data.published_in}
>
  <Content />
</Piece>
