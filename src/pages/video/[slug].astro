---
import { getCollection } from "astro:content";
import Piece from "../../layouts/Piece.astro";

export async function getStaticPaths() {
  const entries = await getCollection("videos");
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { source, video_id, url, description, recorded } = entry.data;
---

<Piece title={entry.data.title}>
  {
    source === "youtube" ? (
      <iframe
        width="100%"
        height="315"
        loading="lazy"
        src={`https://www.youtube-nocookie.com/embed/${video_id}`}
        title={entry.data.title}
        frameborder="0"
        allowfullscreen
      />
    ) : (
      <p>
        <a href={url}>فیس بک پر ویڈیو دیکھیں</a>
      </p>
    )
  }
  {description && <p class="meta">{description}</p>}
  {
    recorded && (
      <p class="meta">ریکارڈنگ: {recorded.toISOString().slice(0, 10)}</p>
    )
  }
</Piece>
