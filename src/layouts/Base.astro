---
import "../styles/global.css";

interface Props {
  title: string;
  dir?: "rtl" | "ltr";
}

const { title, dir = "rtl" } = Astro.props;
---

<!doctype html>
<html lang={dir === "rtl" ? "ur" : "en"} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — غلام حسین ساجد</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu:wght@400;600&display=swap"
    />
  </head>
  <body>
    <nav>
      <a href="/">صفحۂ اوّل</a>
      <a href="/dars-gah/">درس گاہ</a>
    </nav>
    <main><slot /></main>
  </body>
</html>
