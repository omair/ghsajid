---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="ur" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — غلام حسین ساجد</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500&family=Noto+Nastaliq+Urdu:wght@400;600&display=swap"
    />
  </head>
  <body>
    <div class="shell">
      <header class="masthead">
        {
          isHome ? (
            <span class="masthead__name">غلام حسین ساجد</span>
          ) : (
            <a class="masthead__name" href="/">
              غلام حسین ساجد
            </a>
          )
        }
        <nav class="masthead__nav">
          <a href="/dars-gah/">درس گاہ</a>
          <a href="/ghazal/">غزلیں</a>
          <a href="/nazm/">نظمیں</a>
          <a href="/tabsira/">تبصرے</a>
          <a href="/video/">آواز</a>
        </nav>
      </header>
      <main><slot /></main>
    </div>
    <footer class="pagefoot">
      <p>غلام حسین ساجد ۔ شاعر، نقّاد ۔ بستی کبیر سنپال</p>
    </footer>
  </body>
</html>
