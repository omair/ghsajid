---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  measure?: "wide" | "index";
}

const { title, description, measure } = Astro.props;
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="ur" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — غلام حسین ساجد</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500&family=Noto+Nastaliq+Urdu:wght@400;600&display=swap"
    />
  </head>
  <body>
    <div
      class:list={[
        "shell",
        { "shell--wide": measure === "wide", "shell--index": measure === "index" },
      ]}
    >
      <header class="masthead">
        <div class="masthead__brand">
          {
            isHome ? (
              <span class="masthead__name">غلام حسین ساجد</span>
            ) : (
              <a class="masthead__name" href="/">
                غلام حسین ساجد
              </a>
            )
          }
          <span class="masthead__latin" dir="ltr">Ghulam Hussain Sajid</span>
        </div>
        <nav class="masthead__nav">
          <a href="/dars-gah/">درس گاہ</a>
          <a href="/ghazal/">غزلیں</a>
          <a href="/nazm/">نظمیں</a>
          <a href="/tabsira/">تبصرے</a>
          <a href="/video/">آواز</a>
        </nav>
      </header>
      <main><slot /></main>
    </div>
    <footer
      class:list={[
        "pagefoot",
        {
          "pagefoot--wide": measure === "wide",
          "pagefoot--index": measure === "index",
        },
      ]}
    >
      <p>غلام حسین ساجد ۔ شاعر ، نقّاد ، استاد ۔ بستی کبیر سنپال ، لاہور</p>
      <span class="pagefoot__latin" dir="ltr">
        Ghulam Hussain Sajid · Poet · Critic · Teacher
      </span>
    </footer>
  </body>
</html>
