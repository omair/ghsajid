---
import Base from "./Base.astro";

interface Props {
  title: string;
  label?: string;
  verse?: boolean;
  publishedIn?: string[];
  writtenNote?: string;
  backHref?: string;
  backLabel?: string;
  hideTitle?: boolean;
}

const {
  title,
  label,
  verse = false,
  publishedIn = [],
  writtenNote,
  backHref,
  backLabel,
  hideTitle = false,
} = Astro.props;
---

<Base title={title}>
  <article class:list={["piece", { "piece--verse": verse }]}>
    {backHref && <a class="piece__back" href={backHref}>→ {backLabel}</a>}
    {!hideTitle && <h1 class="piece__title">{title}</h1>}
    {label && <p class="piece__label">{label}</p>}
    <div class={verse ? "verse" : "prose"}>
      <slot />
    </div>
    {
      (writtenNote || publishedIn.length > 0) && (
        <footer class="piece__foot">
          {/* The colophon convention his own manuscripts use: place and date. */}
          {writtenNote && <p class="colophon">{writtenNote}</p>}
          {publishedIn.length > 0 && (
            <p class="colophon">اوّلین اشاعت ۔ {publishedIn.join("، ")}</p>
          )}
        </footer>
      )
    }
    <slot name="after" />
  </article>
</Base>
